# Copy to .env.local and adjust. Origin only — no trailing /api, no trailing slash.
# Local:      http://localhost:8080
# Cloud Run:  https://<service>-<hash>-<region>.a.run.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Public address of this site (no trailing slash), for link previews when posts are shared.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
