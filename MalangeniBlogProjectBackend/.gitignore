# Firebase service account keys - full admin access to the Firebase/GCP project.
# Patterns cover both the name Google downloads it under and the name we rename it to.
firebase-key.json
*firebase-adminsdk*
*-adminsdk-*

# Environment variables / local secrets.
# Wildcard on purpose: a literal ".env.local" would leave .env, .env.production and
# stray copies like ".env.local.bak" tracked, which is how credentials get committed.
.env
.env.*